rule mini_shai_hulud_c2_activity { meta: author = "detections.ai" description = "Detects network connections, DNS queries, or web requests to domains associated with the Mini Shai-Hulud supply-chain attack." severity = "High" mitre_attack_techniques = "T1105, T1071.001" references = "https://socket.dev/blog/tanstack-npm-packages-compromised-mini-shai-hulud-supply-chain-attack, https://safedep.io/mass-npm-supply-chain-attack-tanstack-mistral/" tags = "attack.command-and-control, detection.emerging-threats"
    reference1 = "https://socket.dev/blog/tanstack-npm-packages-compromised-mini-shai-hulud-supply-chain-attack"
    reference2 = "https://safedep.io/mass-npm-supply-chain-attack-tanstack-mistral/"
    false_positive = "filev2.getsession.org is a legitimate centralized file server for the Session messaging protocol. Legitimate use of the Session application on developer endpoints may trigger false positives and should be filtered."
events: $e1.metadata.event_type = "NETWORK_CONNECTION" $e1.target.hostname = /filev2\.getsession\.org$|git-tanstack\.com$/ nocase $e2.metadata.event_type = "DNS_REQUEST" $e2.network.dns.questions.name = /filev2\.getsession\.org$|git-tanstack\.com$/ nocase $e3.metadata.event_type = "WEB_REQUEST" $e3.target.url = /filev2\.getsession\.org|git-tanstack\.com/ nocase condition: $e1 or $e2 or $e3 }